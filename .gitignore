# ── Monorepo root ignores ───────────────────────────────────────────────
# Per-stack rules live in frontend/.gitignore (Flutter) and backend/.gitignore
# (Python/Django). The entries below are a root-level safety net + the bits
# those files miss.

# Stray npm tooling that was used only to inspect the prebuilt SQLite DB —
# not part of the Flutter app.
frontend/node_modules/
frontend/package.json
frontend/package-lock.json

# Secrets — never commit, regardless of stack (.env.example stays tracked).
**/.env
!**/.env.example

# Python artefacts (safety net; also covered by backend/.gitignore).
**/__pycache__/
*.py[cod]
**/venv/
**/.venv/

# Local SQLite dev DB (safety net; also covered by backend/.gitignore).
**/db.sqlite3
**/db.sqlite3-journal

# OS / editor
.DS_Store
.idea/

# Auxiliary reference material (saved web pages); not part of the app.
tajweed rules/

# ── Stray Flutter artefacts at the repo ROOT ─────────────────────────────
# The Flutter app lives in frontend/; these root-level entries are leftovers
# from before the monorepo restructure (there is no root pubspec.yaml, so
# they are orphaned and regenerable). Each is anchored with a leading "/" so
# it matches ONLY the repo root — the tracked frontend/android, frontend/ios,
# frontend/build, etc. are unaffected.
/.dart_tool/
/.flutter-plugins-dependencies
/android/
/ios/
/build/
/pubspec.lock
/.vscode/
